APP_NAME="Freelance Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Behind a reverse proxy: its IP, or * when only the proxy can reach the app.
TRUSTED_PROXIES=
APP_PORT=127.0.0.1:8080

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail defaults (local only, never use in production)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=freelance_tracker
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=127.0.0.1:5433

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Alerts by e-mail. Locally "log" writes them to storage/logs; in production use SMTP:
# MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT=587 (STARTTLS) or 465 with MAIL_SCHEME=smtps, MAIL_USERNAME, MAIL_PASSWORD
MAIL_MAILER=log
MAIL_FROM_ADDRESS="tracker@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# Sail
WWWGROUP=1000
WWWUSER=1000

# Backups (spatie/laravel-backup): comma-separated disks, e.g. local,s3. Failures are mailed here.
BACKUP_DISKS=local
BACKUP_NOTIFY_MAIL=
