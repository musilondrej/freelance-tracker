{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "musilondrej/freelance-tracker",
    "type": "project",
    "description": "Self-hosted project management, time tracking and billing for freelancers. Open-source alternative to Toggl, Kimai and Freelo.",
    "keywords": [
        "laravel",
        "filament",
        "time-tracking",
        "billing"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.10",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-csp": "^3.29"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "@php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --parallel"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G"
        ],
        "rector": [
            "rector process"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "phpunit"
        ],
        "check": [
            "pint --test --parallel",
            "rector process --dry-run",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
